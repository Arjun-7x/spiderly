# Copy to `.env` and adjust (loaded automatically at startup; real env vars win).

# Path to the SQLite database file
SPIDERLY_DB_PATH=spiderly.db

# Scanner tunables
SPIDERLY_MAX_CONCURRENCY=200
SPIDERLY_TIMEOUT=0.75
SPIDERLY_MAX_PORTS=5000
SPIDERLY_MAX_ACTIVE_SCANS=3

# --- Access control (recommended whenever the API is reachable by others) ---
# SPIDERLY_API_KEY=change-me
# SPIDERLY_ALLOW_PRIVATE=false
# SPIDERLY_ALLOWED_TARGETS=192.168.56.0/24,10.10.0.0/16

# Comma-separated CORS origins. Tighten before deploying beyond localhost.
SPIDERLY_ALLOWED_ORIGINS=*
